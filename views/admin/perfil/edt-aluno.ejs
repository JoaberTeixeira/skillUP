<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Meu Perfil - Aluno</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-container {
            max-width: 700px;
            margin: 100px auto 40px;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .form-container h1 {
            color: #09316e;
            margin-bottom: 30px;
            text-align: center;
        }

        .form-section {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #ddd;
        }

        .form-section:last-of-type {
            border-bottom: none;
        }

        .form-section h3 {
            color: #09316e;
            font-size: 16px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #09316e;
            font-weight: bold;
            font-size: 14px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="date"],
        input[type="tel"],
        select,
        textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: Arial, sans-serif;
            font-size: 14px;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus,
        input[type="date"]:focus,
        input[type="tel"]:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #92C8E9;
            box-shadow: 0 0 5px rgba(146, 200, 233, 0.3);
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        .file-input-wrapper {
            position: relative;
            margin-bottom: 15px;
        }

        input[type="file"] {
            padding: 10px;
            border: 2px dashed #92C8E9;
            border-radius: 8px;
            width: 100%;
            cursor: pointer;
        }

        .media-preview {
            max-width: 200px;
            max-height: 200px;
            border-radius: 8px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
        }

        .tags-input-container {
            margin-bottom: 15px;
        }

        .tags-input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .tags-display {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag-item {
            background: #92C8E9;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .tag-item button {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            font-weight: bold;
            padding: 0;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            margin-top: 30px;
        }

        button,
        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        button[type="submit"] {
            background: #09316e;
            color: white;
        }

        button[type="submit"]:hover {
            background: #0a4199;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(9, 49, 110, 0.3);
        }

        .btn-cancelar {
            background: #92C8E9;
            color: #09316e;
        }

        .btn-cancelar:hover {
            background: #7ab8d9;
            transform: translateY(-2px);
        }

        .help-text {
            font-size: 12px;
            color: #666;
            margin-top: -10px;
            margin-bottom: 15px;
        }

        .nivel-selector {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .nivel-option {
            flex: 1;
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            font-weight: bold;
            transition: all 0.3s;
        }

        .nivel-option:hover {
            border-color: #92C8E9;
        }

        .nivel-option.selected {
            border-color: #09316e;
            background: #09316e;
            color: white;
        }
    </style>
</head>
<body>
    <%- include('../cabecario', { titulo: 'SkillUP - Editar Perfil' }) %>

    <div class="form-container">
        <h1>✏️ Editar Meu Perfil de Aluno</h1>
        
        <form action="/admin/perfil/edt" method="post" enctype="multipart/form-data">
            <!-- Foto de Perfil -->
            <div class="form-section">
                <h3>📸 Foto de Perfil</h3>
                <% if (usuario.foto) { %>
                    <img src="<%= usuario.foto %>" alt="Foto atual" class="media-preview">
                <% } %>
                <label for="foto">Alterar Foto</label>
                <div class="file-input-wrapper">
                    <input id="foto" name="foto" type="file" accept="image/*">
                </div>
                <p class="help-text">Formatos aceitos: JPG, PNG, GIF (máx. 5MB)</p>
            </div>

            <!-- Informações Básicas -->
            <div class="form-section">
                <h3>📋 Informações Básicas</h3>
                
                <label for="nome">Nome Completo *</label>
                <input id="nome" name="nome" type="text" value="<%= usuario.nome %>" required>

                <label for="email">Email *</label>
                <input id="email" name="email" type="email" value="<%= usuario.email %>" required>

                <label for="telefone">Telefone</label>
                <input id="telefone" name="telefone" type="tel" value="<%= usuario.telefone || '' %>" placeholder="(11) 99999-9999">

                <label for="localizacao">Localização</label>
                <input id="localizacao" name="localizacao" type="text" value="<%= usuario.localizacao || '' %>" placeholder="Cidade/Estado">

                <label for="dataNascimento">Data de Nascimento</label>
                <input id="dataNascimento" name="dataNascimento" type="date" value="<%= usuario.dataNascimento ? usuario.dataNascimento.toISOString().split('T')[0] : '' %>">
            </div>

            <!-- Nível de Experiência -->
            <div class="form-section">
                <h3>⚡ Nível de Experiência</h3>
                <label>Selecione seu nível:</label>
                <div class="nivel-selector">
                    <label class="nivel-option <%= usuario.nivelExperiencia === 'iniciante' ? 'selected' : '' %>">
                        <input type="radio" name="nivelExperiencia" value="iniciante" <%= usuario.nivelExperiencia === 'iniciante' ? 'checked' : '' %> style="display: none;">
                        Iniciante
                    </label>
                    <label class="nivel-option <%= usuario.nivelExperiencia === 'intermediario' ? 'selected' : '' %>">
                        <input type="radio" name="nivelExperiencia" value="intermediario" <%= usuario.nivelExperiencia === 'intermediario' ? 'checked' : '' %> style="display: none;">
                        Intermediário
                    </label>
                    <label class="nivel-option <%= usuario.nivelExperiencia === 'avancado' ? 'selected' : '' %>">
                        <input type="radio" name="nivelExperiencia" value="avancado" <%= usuario.nivelExperiencia === 'avancado' ? 'checked' : '' %> style="display: none;">
                        Avançado
                    </label>
                </div>
            </div>

            <!-- Especialidades -->
            <div class="form-section">
                <h3>🏆 Especialidades</h3>
                <label for="especialidades">Seus principais esportes/especialidades (separe por vírgula)</label>
                <input id="especialidades" name="especialidades" type="text" value="<%= usuario.especialidades ? usuario.especialidades.join(', ') : '' %>" placeholder="Ex: Futsal, Basquete, Vôlei">
                <p class="help-text">Digite os esportes em que você pratica, separados por vírgula</p>
            </div>

            <!-- Interesses -->
            <div class="form-section">
                <h3>❤️ Interesses Esportivos</h3>
                <label for="interesses">Esportes que gostaria de aprender (separe por vírgula)</label>
                <input id="interesses" name="interesses" type="text" value="<%= usuario.interesses ? usuario.interesses.join(', ') : '' %>" placeholder="Ex: Padel, Tênis, Futevôlei">
                <p class="help-text">Esportes que você tem interesse em praticar</p>
            </div>

            <!-- Bio -->
            <div class="form-section">
                <h3>📝 Sobre Mim</h3>
                <label for="bio">Sua bio pessoal</label>
                <textarea id="bio" name="bio" placeholder="Conte um pouco sobre você, seus objetivos e paixões pelo esporte..."><%= usuario.bio || '' %></textarea>
                <p class="help-text">Máximo 500 caracteres para descrever você</p>
            </div>

            <!-- Segurança -->
            <div class="form-section">
                <h3>🔐 Segurança</h3>
                <label for="senha">Nova Senha (opcional)</label>
                <input id="senha" name="senha" type="password" placeholder="Deixe em branco para manter a senha atual">
                <p class="help-text">Preencha apenas se deseja alterar sua senha</p>
            </div>

            <!-- Ações -->
            <div class="form-actions">
                <button type="submit">💾 Salvar Alterações</button>
                <a class="btn btn-cancelar" href="/admin/perfil">Cancelar</a>
            </div>
        </form>
    </div>

    <script>
        // JavaScript para interatividade dos seletores de nível
        document.querySelectorAll('.nivel-option').forEach(option => {
            option.addEventListener('click', function() {
                document.querySelectorAll('.nivel-option').forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                this.querySelector('input[type="radio"]').checked = true;
            });
        });
    </script>
</body>
</html>
