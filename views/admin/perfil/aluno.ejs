<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil - Aluno</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .perfil-container {
            max-width: 900px;
            margin: 100px auto 40px;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .perfil-header {
            background: linear-gradient(135deg, #09316e 0%, #92C8E9 100%);
            padding: 40px 30px;
            color: white;
            text-align: center;
            position: relative;
        }

        .avatar-grande {
            width: 120px;
            height: 120px;
            margin: 0 auto 20px;
            border-radius: 50%;
            border: 4px solid white;
            overflow: hidden;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            font-weight: bold;
            color: #09316e;
        }

        .avatar-grande img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .perfil-header h1 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .perfil-role-badge {
            display: inline-block;
            background: #9AF995;
            color: #09316e;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 14px;
            margin-top: 10px;
        }

        .perfil-content {
            padding: 40px;
        }

        .secao {
            margin-bottom: 30px;
        }

        .secao-titulo {
            font-size: 20px;
            font-weight: bold;
            color: #09316e;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #92C8E9;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .info-item {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #92C8E9;
        }

        .info-item strong {
            color: #09316e;
            display: block;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .info-item p {
            color: #333;
            font-size: 15px;
            margin: 0;
        }

        .info-item.vazio p {
            color: #999;
            font-style: italic;
        }

        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .tag {
            background: #9AF995;
            color: #09316e;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .tag.especialidade {
            background: #92C8E9;
            color: white;
        }

        .bio-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #9AF995;
            line-height: 1.6;
            color: #333;
        }

        .acoes {
            display: flex;
            gap: 12px;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
        }

        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            text-align: center;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: #09316e;
            color: white;
        }

        .btn-primary:hover {
            background: #0a4199;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(9, 49, 110, 0.3);
        }

        .btn-secondary {
            background: #92C8E9;
            color: #09316e;
        }

        .btn-secondary:hover {
            background: #7ab8d9;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(146, 200, 233, 0.3);
        }

        .nivel-badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 13px;
        }

        .nivel-iniciante {
            background: #FFE5B4;
            color: #CC6600;
        }

        .nivel-intermediario {
            background: #92C8E9;
            color: white;
        }

        .nivel-avancado {
            background: #9AF995;
            color: #09316e;
        }
    </style>
</head>
<body>
    <%- include('../cabecario', { titulo: 'SkillUP - Meu Perfil' }) %>

    <div class="perfil-container">
        <div class="perfil-header">
            <div class="avatar-grande">
                <% if (usuario.foto) { %>
                    <img src="<%= usuario.foto %>" alt="Foto de perfil">
                <% } else { %>
                    <%= usuario.nome ? usuario.nome.slice(0, 1) : 'A' %>
                <% } %>
            </div>
            <h1><%= usuario.nome %></h1>
            <span class="perfil-role-badge">👨‍🎓 Aluno</span>
        </div>

        <div class="perfil-content">
            <!-- Informações Básicas -->
            <div class="secao">
                <div class="secao-titulo">📋 Informações Básicas</div>
                <div class="info-grid">
                    <div class="info-item">
                        <strong>Email</strong>
                        <p><%= usuario.email %></p>
                    </div>
                    <div class="info-item">
                        <strong>Telefone</strong>
                        <p><%= usuario.telefone || 'Não informado' %></p>
                    </div>
                    <div class="info-item">
                        <strong>Localização</strong>
                        <p><%= usuario.localizacao || 'Não informada' %></p>
                    </div>
                    <div class="info-item">
                        <strong>Data de Nascimento</strong>
                        <p><%= usuario.dataNascimento ? new Date(usuario.dataNascimento).toLocaleDateString('pt-BR') : 'Não informada' %></p>
                    </div>
                </div>
            </div>

            <!-- Nível de Experiência -->
            <div class="secao">
                <div class="secao-titulo">⚡ Nível de Experiência</div>
                <div class="info-grid">
                    <div class="info-item">
                        <strong>Seu Nível</strong>
                        <p>
                            <span class="nivel-badge nivel-<%= usuario.nivelExperiencia || 'iniciante' %>">
                                <% 
                                    const niveis = {
                                        'iniciante': 'Iniciante',
                                        'intermediario': 'Intermediário',
                                        'avancado': 'Avançado'
                                    };
                                %>
                                <%= niveis[usuario.nivelExperiencia || 'iniciante'] %>
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Especialidades -->
            <% if (usuario.especialidades && usuario.especialidades.length > 0) { %>
            <div class="secao">
                <div class="secao-titulo">🏆 Especialidades</div>
                <div class="tags-container">
                    <% usuario.especialidades.forEach(esp => { %>
                        <span class="tag especialidade"><%= esp %></span>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <!-- Interesses -->
            <% if (usuario.interesses && usuario.interesses.length > 0) { %>
            <div class="secao">
                <div class="secao-titulo">❤️ Interesses Esportivos</div>
                <div class="tags-container">
                    <% usuario.interesses.forEach(int => { %>
                        <span class="tag"><%= int %></span>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <!-- Bio -->
            <% if (usuario.bio) { %>
            <div class="secao">
                <div class="secao-titulo">📝 Sobre Mim</div>
                <div class="bio-section">
                    <%= usuario.bio %>
                </div>
            </div>
            <% } %>

            <!-- Ações -->
            <div class="acoes">
                <a href="/admin/perfil/edt" class="btn btn-primary">✏️ Editar Perfil</a>
                <a href="/admin/postagem/lst" class="btn btn-secondary">📸 Minhas Postagens</a>
            </div>
        </div>
    </div>
</body>
</html>
