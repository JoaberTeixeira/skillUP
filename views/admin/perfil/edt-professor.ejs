<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Meu Perfil - Professor</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-container {
            max-width: 700px;
            margin: 100px auto 40px;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .form-container h1 {
            color: #09316e;
            margin-bottom: 30px;
            text-align: center;
        }

        .form-section {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid #ddd;
        }

        .form-section:last-of-type {
            border-bottom: none;
        }

        .form-section h3 {
            color: #09316e;
            font-size: 16px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #09316e;
            font-weight: bold;
            font-size: 14px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="date"],
        input[type="tel"],
        input[type="number"],
        select,
        textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: Arial, sans-serif;
            font-size: 14px;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus,
        input[type="date"]:focus,
        input[type="tel"]:focus,
        input[type="number"]:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #92C8E9;
            box-shadow: 0 0 5px rgba(146, 200, 233, 0.3);
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        .file-input-wrapper {
            position: relative;
            margin-bottom: 15px;
        }

        input[type="file"] {
            padding: 10px;
            border: 2px dashed #92C8E9;
            border-radius: 8px;
            width: 100%;
            cursor: pointer;
        }

        .media-preview {
            max-width: 200px;
            max-height: 200px;
            border-radius: 8px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            margin-top: 30px;
        }

        button,
        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        button[type="submit"] {
            background: #09316e;
            color: white;
        }

        button[type="submit"]:hover {
            background: #0a4199;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(9, 49, 110, 0.3);
        }

        .btn-cancelar {
            background: #92C8E9;
            color: #09316e;
        }

        .btn-cancelar:hover {
            background: #7ab8d9;
            transform: translateY(-2px);
        }

        .help-text {
            font-size: 12px;
            color: #666;
            margin-top: -10px;
            margin-bottom: 15px;
        }

        .info-box {
            background: #f0f8ff;
            border-left: 4px solid #92C8E9;
            padding: 12px;
            border-radius: 5px;
            font-size: 13px;
            color: #333;
            margin-bottom: 15px;
        }

        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .two-column input,
        .two-column select {
            margin-bottom: 0;
        }

        @media (max-width: 600px) {
            .two-column {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <%- include('../cabecario', { titulo: 'SkillUP - Editar Perfil' }) %>

    <div class="form-container">
        <h1>✏️ Editar Meu Perfil de Professor</h1>
        
        <form action="/admin/perfil/edt" method="post" enctype="multipart/form-data">
            <!-- Foto de Perfil -->
            <div class="form-section">
                <h3>📸 Foto de Perfil</h3>
                <% if (usuario.foto) { %>
                    <img src="<%= usuario.foto %>" alt="Foto atual" class="media-preview">
                <% } %>
                <label for="foto">Alterar Foto</label>
                <div class="file-input-wrapper">
                    <input id="foto" name="foto" type="file" accept="image/*">
                </div>
                <p class="help-text">Formatos aceitos: JPG, PNG, GIF (máx. 5MB)</p>
            </div>

            <!-- Informações Básicas -->
            <div class="form-section">
                <h3>📋 Informações Básicas</h3>
                
                <label for="nome">Nome Completo *</label>
                <input id="nome" name="nome" type="text" value="<%= usuario.nome %>" required>

                <label for="email">Email *</label>
                <input id="email" name="email" type="email" value="<%= usuario.email %>" required>

                <div class="two-column">
                    <div>
                        <label for="telefone">Telefone</label>
                        <input id="telefone" name="telefone" type="tel" value="<%= usuario.telefone || '' %>" placeholder="(11) 99999-9999">
                    </div>
                    <div>
                        <label for="localizacao">Localização Principal</label>
                        <input id="localizacao" name="localizacao" type="text" value="<%= usuario.localizacao || '' %>" placeholder="Cidade/Estado">
                    </div>
                </div>

                <label for="dataNascimento">Data de Nascimento</label>
                <input id="dataNascimento" name="dataNascimento" type="date" value="<%= usuario.dataNascimento ? usuario.dataNascimento.toISOString().split('T')[0] : '' %>">
            </div>

            <!-- Experiência Profissional -->
            <div class="form-section">
                <h3>💼 Experiência Profissional</h3>
                
                <label for="experiencia">Anos de Experiência</label>
                <input id="experiencia" name="experiencia" type="number" value="<%= usuario.experiencia || 0 %>" min="0" max="100">

                <label for="totalAulas">Total de Aulas Ministradas</label>
                <input id="totalAulas" name="totalAulas" type="number" value="<%= usuario.totalAulas || 0 %>" min="0" readonly>
                <p class="help-text">Este campo é atualizado automaticamente. Não é editável.</p>

                <label for="avaliacaoMedia">Avaliação Média (0-5)</label>
                <input id="avaliacaoMedia" name="avaliacaoMedia" type="number" value="<%= usuario.avaliacaoMedia || 0 %>" min="0" max="5" step="0.1" readonly>
                <p class="help-text">Este campo é atualizado pelos alunos. Não é editável.</p>
            </div>

            <!-- Especialidades -->
            <div class="form-section">
                <h3>🏆 Especialidades / Esportes que Ensina</h3>
                <label for="especialidades">Esportes que você ensina (separe por vírgula)</label>
                <input id="especialidades" name="especialidades" type="text" value="<%= usuario.especialidades ? usuario.especialidades.join(', ') : '' %>" placeholder="Ex: Futsal, Basquete, Vôlei">
                <p class="help-text">Exemplo: Futsal, Basquete, Vôlei, Futevôlei</p>
            </div>

            <!-- Certificações -->
            <div class="form-section">
                <h3>🎓 Certificações e Qualificações</h3>
                <label for="certificacoes">Suas certificações (separe por vírgula)</label>
                <input id="certificacoes" name="certificacoes" type="text" value="<%= usuario.certificacoes ? usuario.certificacoes.join(', ') : '' %>" placeholder="Ex: Instrutor Certificado CBVA, Técnico em Voleibol">
                <p class="help-text">Exemplo: Instrutor Certificado, Técnico, Bacharel em Educação Física</p>
            </div>

            <!-- Locais de Atuação -->
            <div class="form-section">
                <h3>📍 Locais de Atuação</h3>
                <label for="locaisAtuacao">Cidades/Locais onde você atua (separe por vírgula)</label>
                <input id="locaisAtuacao" name="locaisAtuacao" type="text" value="<%= usuario.locaisAtuacao ? usuario.locaisAtuacao.join(', ') : '' %>" placeholder="Ex: São Paulo, Guarulhos, Barueri">
                <p class="help-text">Locais onde você oferece aulas</p>
            </div>

            <!-- Horários Disponíveis -->
            <!-- <div class="form-section">
                <h3>⏰ Horários Disponíveis</h3>
                <label for="horariosDisponíveis">Seus horários disponíveis</label>
                <textarea id="horariosDisponíveis" name="horariosDisponíveis" placeholder="Ex: Seg-Qua: 19h-22h, Sab-Dom: 8h-18h"><%= usuario.horariosDisponíveis || '' %></textarea>
                <p class="help-text">Descreva em quais dias e horários você está disponível para aulas</p>
            </div> -->

            <!-- Bio -->
            <div class="form-section">
                <h3>📝 Sobre Mim</h3>
                <label for="bio">Sua bio profissional</label>
                <textarea id="bio" name="bio" placeholder="Conte sobre sua experiência, metodologia de ensino, conquistas..."><%= usuario.bio || '' %></textarea>
                <p class="help-text">Máximo 500 caracteres para descrever sua experiência e metodologia</p>
            </div>

            <!-- Segurança -->
            <div class="form-section">
                <h3>🔐 Segurança</h3>
                <label for="senha">Nova Senha (opcional)</label>
                <input id="senha" name="senha" type="password" placeholder="Deixe em branco para manter a senha atual">
                <p class="help-text">Preencha apenas se deseja alterar sua senha</p>
            </div>

            <!-- Ações -->
            <div class="form-actions">
                <button type="submit">💾 Salvar Alterações</button>
                <a class="btn btn-cancelar" href="/admin/perfil">Cancelar</a>
            </div>
        </form>
    </div>
</body>
</html>
