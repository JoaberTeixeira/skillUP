<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Feeds</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('../cabecario', { titulo: 'SkillUP - sistema de aprendizagem' }) %>

    <div class="content">
        <h1>Feed</h1>

        <form action="/admin/feed/lst" method="post" class="feed-filter-form">
            <label for="categoria">Filtrar por categoria:</label>
            <select id="categoria" name="categoria">
                <% if (categorias && categorias.length) { %>
                    <% categorias.forEach(function(cat) { %>
                        <option value="<%= cat %>" <%= selectedCategoria === cat ? 'selected' : '' %>><%= cat === 'todas' ? 'Todas' : cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                    <% }); %>
                <% } else { %>
                    <option value="todas" selected>Todas</option>
                    <option value="esporte">Esporte</option>
                <% } %>
            </select>
            <button type="submit">Filtrar</button>
        </form>

        <% function getVideoMimeType(url) {
            if (/\.mp4$/i.test(url)) return 'video/mp4';
            if (/\.webm$/i.test(url)) return 'video/webm';
            if (/\.ogg$/i.test(url)) return 'video/ogg';
            return 'video/mp4';
        } %>

        <% if (postagens && postagens.length) { %>
            <div style="margin-top: 60px;">
                <h2>Feed de Postagens</h2>
                <div class="feed feed-scroll">
                    <% postagens.forEach(function(postagem) { %>
                        <div class="social-post">
                            <div class="post-header">
                                <div class="avatar">
                                    <% const fotoAutor = postagem.autorFoto || (postagem.autorId && postagem.autorId.foto); %>
                                    <% if (fotoAutor) { %>
                                        <img src="<%= fotoAutor %>" alt="Foto do autor">
                                    <% } else { %>
                                        <%= (postagem.autorNome || 'U').slice(0, 1) %>
                                    <% } %>
                                </div>
                                <div>
                                    <div class="post-user"><%= postagem.autorNome || 'Usuario sem nome' %> (<%= postagem.autorRole || '-' %>)</div>
                                    <% const dataPost = postagem.createdAt ? new Date(postagem.createdAt) : postagem._id.getTimestamp(); %>
                                    <div class="post-meta">Publicado em <%= dataPost.toLocaleString('pt-BR') %></div>
                                    <div class="post-meta">Categoria: <%= postagem.categoria ? postagem.categoria.charAt(0).toUpperCase() + postagem.categoria.slice(1) : 'N/A' %></div>
                                </div>
                            </div>
                            <div class="post-body">
                                <h3><%= postagem.titulo %></h3>
                                <p><%= postagem.descricao %></p>
                                <% const medias = Array.isArray(postagem.midia) ? postagem.midia : (postagem.midia ? [postagem.midia] : []); %>
                                <% if (medias.length) { %>
                                    <div class="post-media">
                                        <% medias.forEach(function(src) { %>
                                            <% const isVideo = /\.(mp4|webm|ogg)$/i.test(src); %>
                                            <% if (isVideo) { %>
                                                <video controls preload="metadata">
                                                    <source src="<%= src %>" type="<%= getVideoMimeType(src) %>">
                                                    Seu navegador nao suporta este video.
                                                </video>
                                            <% } else { %>
                                                <a href="<%= src %>" target="_blank" rel="noopener noreferrer">
                                                    <img src="<%= src %>" alt="Midia da postagem">
                                                </a>
                                            <% } %>
                                        <% }) %>
                                    </div>
                                <% } %>
                                <div class="post-actions">
                                    <% const likedByUser = user && postagem.curtidas && postagem.curtidas.some((like) => like.toString() === user.id); %>
                                    <form action="/admin/postagem/like/<%= postagem._id %>" method="post" class="post-action-form">
                                        <button type="submit" class="btn-action"><%= likedByUser ? 'Descurtir' : 'Curtir' %> (<%= postagem.curtidas ? postagem.curtidas.length : 0 %>)</button>
                                    </form>
                                    <span class="comment-count"><%= postagem.comentarios ? postagem.comentarios.length : 0 %> comentários</span>
                                </div>
                                <div class="comments-list">
                                    <% if (postagem.comentarios && postagem.comentarios.length) { %>
                                        <% postagem.comentarios.slice(-3).reverse().forEach(function(comment) { %>
                                            <div class="comment-item">
                                                <strong><%= comment.autorNome %></strong> <span class="comment-meta">(<%= comment.autorRole %>)</span>
                                                <p class="comment-text-display-<%= comment._id %>"><%= comment.texto %></p>
                                                <div class="comment-actions">
                                                    <button type="button" class="btn-action btn-reply" onclick="toggleReplyForm('<%= postagem._id %>', '<%= comment._id %>')">Responder</button>
                                                    <% if (user && String(comment.autorId) === String(user.id)) { %>
                                                        <button type="button" class="btn-action" onclick="toggleEditComment('<%= comment._id %>', '<%= postagem._id %>')">Editar</button>
                                                        <a href="/admin/postagem/comment/del/<%= postagem._id %>/<%= comment._id %>" class="btn-action btn-danger" onclick="return confirm('Tem certeza que deseja excluir este comentário?');">Excluir</a>
                                                    <% } %>
                                                </div>
                                                <form action="/admin/postagem/comment/edt/<%= postagem._id %>/<%= comment._id %>" method="post" class="comment-edit-form-<%= comment._id %>" style="display:none;">
                                                    <textarea name="texto" required><%= comment.texto %></textarea>
                                                    <div class="comment-edit-buttons">
                                                        <button type="submit" class="btn-action">Salvar</button>
                                                        <button type="button" class="btn-action" onclick="toggleEditComment('<%= comment._id %>', '<%= postagem._id %>')">Cancelar</button>
                                                    </div>
                                                </form>

                                                <!-- Respostas -->
                                                <% if (comment.respostas && comment.respostas.length) { %>
                                                    <div class="replies-list">
                                                        <% comment.respostas.forEach(function(reply) { %>
                                                            <div class="reply-item">
                                                                <strong><%= reply.autorNome %></strong> <span class="comment-meta">(<%= reply.autorRole %>)</span>
                                                                <p class="reply-text-display-<%= reply._id %>"><%= reply.texto %></p>
                                                                <% if (user && String(reply.autorId) === String(user.id)) { %>
                                                                    <div class="reply-actions">
                                                                        <button type="button" class="btn-action" onclick="toggleEditReply('<%= reply._id %>')">Editar</button>
                                                                        <a href="/admin/postagem/comment/reply/del/<%= postagem._id %>/<%= comment._id %>/<%= reply._id %>" class="btn-action btn-danger" onclick="return confirm('Tem certeza que deseja excluir esta resposta?');">Excluir</a>
                                                                    </div>
                                                                    <form action="/admin/postagem/comment/reply/edt/<%= postagem._id %>/<%= comment._id %>/<%= reply._id %>" method="post" class="reply-edit-form-<%= reply._id %>" style="display:none;">
                                                                        <textarea name="texto" required><%= reply.texto %></textarea>
                                                                        <div class="reply-edit-buttons">
                                                                            <button type="submit" class="btn-action">Salvar</button>
                                                                            <button type="button" class="btn-action" onclick="toggleEditReply('<%= reply._id %>')">Cancelar</button>
                                                                        </div>
                                                                    </form>
                                                                <% } %>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                <% } %>

                                                <!-- Formulário de resposta -->
                                                <form action="/admin/postagem/comment/reply/<%= postagem._id %>/<%= comment._id %>" method="post" class="reply-form-<%= comment._id %>" style="display:none;">
                                                    <textarea name="texto" placeholder="Adicione uma resposta..." required></textarea>
                                                    <div class="reply-form-buttons">
                                                        <button type="submit" class="btn-action">Enviar resposta</button>
                                                        <button type="button" class="btn-action" onclick="toggleReplyForm('<%= postagem._id %>', '<%= comment._id %>')">Cancelar</button>
                                                    </div>
                                                </form>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                </div>
                                <form action="/admin/postagem/comment/<%= postagem._id %>" method="post" class="comment-form">
                                    <textarea name="texto" placeholder="Adicione um comentário..." required></textarea>
                                    <button type="submit" class="btn-action">Enviar comentário</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

    </div>

    <script>
        function toggleEditComment(commentId, postagemId) {
            const textDisplay = document.querySelector(`.comment-text-display-${commentId}`);
            const editForm = document.querySelector(`.comment-edit-form-${commentId}`);
            
            if (editForm.style.display === 'none') {
                editForm.style.display = 'block';
                textDisplay.style.display = 'none';
            } else {
                editForm.style.display = 'none';
                textDisplay.style.display = 'block';
            }
        }

        function toggleReplyForm(postagemId, commentId) {
            const replyForm = document.querySelector(`.reply-form-${commentId}`);
            
            if (replyForm.style.display === 'none') {
                replyForm.style.display = 'block';
            } else {
                replyForm.style.display = 'none';
            }
        }

        function toggleEditReply(replyId) {
            const textDisplay = document.querySelector(`.reply-text-display-${replyId}`);
            const editForm = document.querySelector(`.reply-edit-form-${replyId}`);
            
            if (editForm.style.display === 'none') {
                editForm.style.display = 'block';
                textDisplay.style.display = 'none';
            } else {
                editForm.style.display = 'none';
                textDisplay.style.display = 'block';
            }
        }
    </script>

</body>

</html>
